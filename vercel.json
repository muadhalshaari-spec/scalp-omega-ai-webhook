{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/live-stream.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/live-state",
      "destination": "/api/live-stream"
    }
  ],
  "crons": [
    {
      "path": "/api/history-sync?mode=scheduled",
      "schedule": "0 0 * * *"
    }
  ],
  "regions": [
    "bom1"
  ]
}
