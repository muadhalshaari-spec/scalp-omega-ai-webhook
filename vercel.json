{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node -e \"const fs=require('fs');const p='lib/deribit.js';let s=fs.readFileSync(p,'utf8');s=s.replace('https://www.deribit.com/api/v2','https://test.deribit.com/api/v2');fs.writeFileSync(p,s)\"",
  "functions": {
    "api/live-stream.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/live-state",
      "destination": "/api/live-stream"
    }
  ]
}
